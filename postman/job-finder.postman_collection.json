{
  "info": {
    "name": "job-finder API",
    "_postman_id": "b6f1a3d0-7e3a-4c2a-9d1e-job-finder-api",
    "description": "NestJS API (apps/api, prefix /api) + jobspy-sidecar (apps/jobspy-sidecar). Import job-finder.postman_environment.json alongside this collection and set baseUrl/sidecarUrl.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:3000/api" },
    { "key": "sidecarUrl", "value": "http://localhost:8000" },
    { "key": "profileId", "value": "" },
    { "key": "jobId", "value": "" },
    { "key": "searchId", "value": "" },
    { "key": "documentId", "value": "" },
    { "key": "sourceKey", "value": "jobspy" }
  ],
  "item": [
    {
      "name": "Profiles",
      "item": [
        {
          "name": "List profiles",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/profiles"
          }
        },
        {
          "name": "Create profile",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('status 201', () => pm.response.code === 201 || pm.response.code === 200);",
                  "const body = pm.response.json();",
                  "if (body?.id) pm.collectionVariables.set('profileId', body.id);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/profiles",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Default\",\n  \"document\": {\n    \"basics\": {\n      \"name\": \"Jane Doe\",\n      \"email\": \"jane@example.com\",\n      \"summary\": \"Backend engineer, 6 years, TS/Node/Postgres.\"\n    },\n    \"work\": [\n      {\n        \"name\": \"Acme Corp\",\n        \"position\": \"Senior Backend Engineer\",\n        \"startDate\": \"2021-01\",\n        \"highlights\": [\"Built event-driven ingestion pipeline\", \"Led migration to NestJS\"]\n      }\n    ],\n    \"skills\": [{ \"name\": \"TypeScript\" }, { \"name\": \"PostgreSQL\" }]\n  },\n  \"extraNotes\": \"Open to remote only.\"\n}"
            }
          }
        },
        {
          "name": "Get profile by id",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/profiles/{{profileId}}"
          }
        },
        {
          "name": "Update profile",
          "request": {
            "method": "PUT",
            "url": "{{baseUrl}}/profiles/{{profileId}}",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Default (updated)\",\n  \"extraNotes\": \"Open to remote or hybrid EU.\"\n}"
            }
          }
        },
        {
          "name": "Import profile from PDF",
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/profiles/import",
            "body": {
              "mode": "formdata",
              "formdata": [
                { "key": "file", "type": "file", "src": "" }
              ]
            }
          }
        },
        {
          "name": "Delete profile",
          "request": {
            "method": "DELETE",
            "url": "{{baseUrl}}/profiles/{{profileId}}"
          }
        }
      ]
    },
    {
      "name": "Sources",
      "item": [
        {
          "name": "List sources",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/sources"
          }
        },
        {
          "name": "Update source config",
          "request": {
            "method": "PUT",
            "url": "{{baseUrl}}/sources/{{sourceKey}}",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"enabled\": true,\n  \"config\": {}\n}"
            }
          }
        },
        {
          "name": "Test source",
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/sources/{{sourceKey}}/test"
          }
        }
      ]
    },
    {
      "name": "Searches",
      "item": [
        {
          "name": "List saved searches",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/searches"
          }
        },
        {
          "name": "Create saved search",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const body = pm.response.json();",
                  "if (body?.id) pm.collectionVariables.set('searchId', body.id);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/searches",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Remote NestJS roles\",\n  \"query\": {\n    \"keywords\": \"nestjs backend\",\n    \"remote\": true,\n    \"location\": \"Europe\",\n    \"sources\": [\"jobspy\"],\n    \"site\": \"linkedin\"\n  },\n  \"cron\": \"0 */6 * * *\",\n  \"enabled\": true\n}"
            }
          }
        },
        {
          "name": "Update saved search",
          "request": {
            "method": "PUT",
            "url": "{{baseUrl}}/searches/{{searchId}}",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"enabled\": false\n}"
            }
          }
        },
        {
          "name": "Run saved search now",
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/searches/{{searchId}}/run"
          }
        },
        {
          "name": "Recent source runs",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/searches/runs/recent"
          }
        },
        {
          "name": "Delete saved search",
          "request": {
            "method": "DELETE",
            "url": "{{baseUrl}}/searches/{{searchId}}"
          }
        }
      ]
    },
    {
      "name": "Jobs",
      "item": [
        {
          "name": "List jobs (default)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const body = pm.response.json();",
                  "if (body?.items?.length) pm.collectionVariables.set('jobId', body.items[0].id);"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/jobs"
          }
        },
        {
          "name": "List jobs (filtered + paged)",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/jobs?sort=score&source=jobspy&minScore=60&status=found&remote=true&q=backend&page=1&pageSize=20",
              "host": ["{{baseUrl}}"],
              "path": ["jobs"],
              "query": [
                { "key": "sort", "value": "score" },
                { "key": "source", "value": "jobspy" },
                { "key": "minScore", "value": "60" },
                { "key": "status", "value": "found" },
                { "key": "remote", "value": "true" },
                { "key": "q", "value": "backend" },
                { "key": "page", "value": "1" },
                { "key": "pageSize", "value": "20" }
              ]
            }
          }
        },
        {
          "name": "Get job by id",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/jobs/{{jobId}}"
          }
        },
        {
          "name": "Shortlist job",
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/jobs/{{jobId}}/shortlist"
          }
        },
        {
          "name": "Hide job",
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/jobs/{{jobId}}/hide"
          }
        },
        {
          "name": "Generate document for job (202)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('status 202', () => pm.response.code === 202);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/jobs/{{jobId}}/generate",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"type\": \"resume\",\n  \"profileId\": \"{{profileId}}\"\n}"
            }
          }
        },
        {
          "name": "List documents for job",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const body = pm.response.json();",
                  "if (Array.isArray(body) && body.length) pm.collectionVariables.set('documentId', body[0].id);"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/jobs/{{jobId}}/documents"
          }
        }
      ]
    },
    {
      "name": "Documents",
      "item": [
        {
          "name": "Tailor resume ad-hoc (no DB job)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const body = pm.response.json();",
                  "if (body?.id) pm.collectionVariables.set('documentId', body.id);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/documents/tailor",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"vacancy\": \"We are looking for a Senior Backend Engineer with strong TypeScript, NestJS and PostgreSQL experience to join our remote-first team...\",\n  \"company\": \"Acme Corp\",\n  \"title\": \"Senior Backend Engineer\",\n  \"groundingLevel\": \"moderate\"\n}"
            }
          }
        },
        {
          "name": "Get document by id",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/documents/{{documentId}}"
          }
        },
        {
          "name": "Update document text",
          "request": {
            "method": "PUT",
            "url": "{{baseUrl}}/documents/{{documentId}}",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"text\": \"# Jane Doe\\n...edited yaml/text content...\"\n}"
            }
          }
        },
        {
          "name": "Download document PDF",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/documents/{{documentId}}/pdf"
          }
        }
      ]
    },
    {
      "name": "Applications",
      "item": [
        {
          "name": "List applications",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/applications"
          }
        },
        {
          "name": "List applications (by status)",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/applications?status=applied",
              "host": ["{{baseUrl}}"],
              "path": ["applications"],
              "query": [{ "key": "status", "value": "applied" }]
            }
          }
        },
        {
          "name": "Update application",
          "request": {
            "method": "PATCH",
            "url": "{{baseUrl}}/applications/{{jobId}}",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"status\": \"applied\",\n  \"notes\": \"Applied via company site\"\n}"
            }
          }
        },
        {
          "name": "Stats",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/stats"
          }
        }
      ]
    },
    {
      "name": "jobspy-sidecar",
      "item": [
        {
          "name": "Health",
          "request": {
            "method": "GET",
            "url": "{{sidecarUrl}}/health"
          }
        },
        {
          "name": "Search jobs",
          "request": {
            "method": "POST",
            "url": "{{sidecarUrl}}/search",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"site\": \"linkedin\",\n  \"search_term\": \"backend engineer\",\n  \"location\": \"remote\",\n  \"is_remote\": true,\n  \"results_wanted\": 10,\n  \"hours_old\": 72,\n  \"country_indeed\": \"usa\"\n}"
            }
          }
        }
      ]
    }
  ]
}
