# .claude/ is excluded by a global gitignore (~/.gitignore_global). Re-include
# the committed hook registry so every clone/worktree gets it (FR-028);
# settings.local.json (permission allowlist, may contain secrets) stays local.
!.claude/
.claude/*
!.claude/settings.json
.playwright-mcp/
