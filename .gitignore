# .claude/ is excluded by a global gitignore (~/.gitignore_global). Re-include
# the committed hook registry and speckit skills so every clone/worktree gets
# them (FR-028, 024-agent-context-consolidation); settings.local.json
# (permission allowlist, may contain secrets) and worktrees/ stay local.
!.claude/
.claude/*
!.claude/settings.json
!.claude/skills/
.playwright-mcp/

# opencode agent tooling (local, contains node_modules)
.opencode/
