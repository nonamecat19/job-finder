{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://jobfinder.internal/schema/result.schema.json",
  "properties": {
    "status": {
      "type": "string"
    },
    "result": {
      "type": "object"
    },
    "failure": {
      "properties": {
        "category": {
          "type": "string"
        },
        "retryable": {
          "type": "boolean"
        },
        "message": {
          "type": "string"
        },
        "failed_step": {
          "type": "string"
        }
      },
      "additionalProperties": false,
      "type": "object",
      "required": [
        "category",
        "retryable",
        "message"
      ]
    },
    "trace_id": {
      "type": "string"
    },
    "snapshot_hash": {
      "type": "string"
    },
    "usage": {
      "properties": {
        "input_tokens": {
          "type": "integer"
        },
        "output_tokens": {
          "type": "integer"
        },
        "cost_usd": {
          "type": "number"
        }
      },
      "additionalProperties": false,
      "type": "object"
    }
  },
  "additionalProperties": false,
  "type": "object",
  "required": [
    "status"
  ],
  "title": "result"
}
