{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "outDir": "dist",
    "baseUrl": ".",
    "emitDecoratorMetadata": true,
    "experimentalDecorators": true,
    "strictPropertyInitialization": false,
    "declaration": false,
    "removeComments": true,
    "allowSyntheticDefaultImports": true,
    "incremental": true
  },
  "include": ["src", "scripts"],
  "exclude": ["node_modules", "dist"]
}
