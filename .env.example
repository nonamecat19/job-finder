# Postgres
DB_PASSWORD=change-me
DATABASE_URL=postgresql://jobfinder:change-me@localhost:5432/jobfinder

# Redis (BullMQ)
REDIS_URL=redis://localhost:6379

# LLM
# LLM_PROVIDER: ollama (local) | cerebras (hosted, fast). Embeddings always use Ollama.
LLM_PROVIDER=ollama
OLLAMA_URL=http://localhost:11434
LLM_MODEL=qwen2.5:14b
EMBED_MODEL=nomic-embed-text

# Cerebras (when LLM_PROVIDER=cerebras). Chat only — no embeddings endpoint.
CEREBRAS_API_KEY=
CEREBRAS_MODEL=gpt-oss-120b
CEREBRAS_URL=https://api.cerebras.ai/v1
EMBED_DIMS=768
MATCH_SIMILARITY_THRESHOLD=0.35

# 32-byte hex key for aes-256-gcm encryption of JobSource.config
# generate: openssl rand -hex 32
CONFIG_ENCRYPTION_KEY=

# Job source credentials
ADZUNA_APP_ID=
ADZUNA_APP_KEY=
ADZUNA_COUNTRY=gb
DJINNI_SESSION_COOKIE=

# Sidecar / optional services
JOBSPY_URL=http://localhost:8000
FLARESOLVERR_URL=

# Paths
DOCUMENTS_DIR=/data/documents

# RenderCV tailoring (vacancy-tailored resume)
RESUME_MASTER_PATH=./resume/resume.yaml
RESUME_GROUNDING_LEVEL=moderate
RENDERCV_BIN=rendercv
