DB_PASSWORD=change-me
DATABASE_URL=postgresql://jobfinder:change-me@localhost:5432/jobfinder

# --- Database connection capacity (026-db-pool-capacity) ---
# DB_MAX_CONNS=0 derives capacity as (sum of worker pool sizes) + 2 background
# + DB_INTERACTIVE_RESERVE. With shipped concurrency defaults that is 25.
# Set explicitly only to override; a value below what the workload requires
# fails startup with a message naming the settings in conflict.
DB_MAX_CONNS=0
DB_MIN_CONNS=2
DB_MAX_CONN_LIFETIME=1h
DB_MAX_CONN_IDLE_TIME=30m
# How long an interactive HTTP request waits for a free connection before
# failing with a capacity error instead of hanging indefinitely.
DB_ACQUIRE_TIMEOUT=5s
# What your Postgres max_connections actually is. Declared, not queried —
# used to warn when DB_MAX_CONNS would exceed what the server will grant.
DB_SERVER_MAX_CONNS=100
# Connections budgeted for dashboard/API traffic above total worker concurrency.
DB_INTERACTIVE_RESERVE=8

REDIS_URL=redis://localhost:6379

# Test database (separate DB name in same Postgres container, separate Redis DB index)
TEST_DATABASE_URL=postgresql://jobfinder:${DB_PASSWORD}@localhost:5432/jobfinder_test
TEST_REDIS_URL=redis://localhost:6379/1

# LLM — gateway only (044-litellm-only-routing, Constitution Principle V
# 2.0.0). There is no local/self-hosted inference path: every AI request —
# match, generation, salary, outreach, recruiter, embeddings, every stage —
# goes through the self-hosted LiteLLM proxy to a third-party hosted provider.
#
# Prompt content leaves the deployment on every request, unconditionally.
# Profile data, resume content, job posting text: all of it is sent to
# whichever hosted provider (Groq, Cohere, OpenRouter, Cerebras, OpenAI, or an
# upstream behind OpenRouter such as Anthropic) currently leads or is next in
# that scenario's fallback chain in gateway/config.yaml. There is no
# configuration flag, offline mode, or local model under which this stops
# being true.
#
# GATEWAY_URL and LITELLM_MASTER_KEY are REQUIRED — the application refuses to
# boot without them, naming the missing key (contracts/configuration.md K1).
# Use http://localhost:4000 (the port compose publishes) when the backend runs
# on the host, and http://litellm:4000 only when it runs inside the compose
# network — the service hostname does not resolve outside it.
GATEWAY_URL=http://localhost:4000
# LITELLM_MASTER_KEY authenticates the backend to the proxy
# (general_settings.master_key in gateway/config.yaml). It is the one secret
# the application container is permitted to hold.
LITELLM_MASTER_KEY=
# The provider keys below (CEREBRAS_API_KEY, OPENROUTER_API_KEY,
# OPENAI_API_KEY) are consumed inside the litellm container only, per the
# chains in gateway/config.yaml — the Go backend never reads them and never
# knows which upstream served a request beyond the served_model log line.
# Which models serve which scenario is a gateway/config.yaml edit plus
# `docker compose restart litellm`, never a variable here
# (contracts/gateway-config.md C5).
CEREBRAS_API_KEY=
OPENROUTER_API_KEY=
# OPENAI_API_KEY backs the embed chain only (single provider since
# 2026-08-13, when Cohere and Groq were removed).
OPENAI_API_KEY=
# EMBED_DIMS must equal the "embed" group's declared output_dimension in
# gateway/config.yaml. Changing it is NOT a config-only change — it requires a
# migration and re-embedding (contracts/gateway-config.md C5-1).
EMBED_DIMS=1024
MATCH_SIMILARITY_THRESHOLD=0.35
# Lifetime (seconds) of cached keyword-diff rephrase suggestions (async/cached).
KEYWORD_REPHRASE_CACHE_TTL_SEC=900

AI_CONCURRENCY_CLOUD=3
INGEST_CONCURRENCY=2
ENRICH_CONCURRENCY=1

# Postings stored per statement batch inside an ingest run's transaction.
# Bounds statement size and lock duration only — every chunk of a run still
# commits together, and one failing rolls the whole run back.
INGEST_PERSIST_CHUNK_SIZE=500

AI_TASK_TIMEOUT_MATCH=5m
AI_TASK_TIMEOUT_GENERATE=15m
AI_TASK_TIMEOUT_SALARY=5m
AI_TASK_TIMEOUT_GHOST=5m
AI_TASK_TIMEOUT_ENRICH=10m
AI_TASK_TIMEOUT_INGEST=30m

ACTIVITY_HEARTBEAT_INTERVAL=30s
ACTIVITY_STALE_AFTER=2m
ACTIVITY_SWEEP_INTERVAL=1m
ACTIVITY_QUEUED_GRACE=30m

LLM_MAX_IDLE_CONNS_PER_HOST=4

CONFIG_ENCRYPTION_KEY=

ADZUNA_APP_ID=
ADZUNA_APP_KEY=
ADZUNA_COUNTRY=gb

DJINNI_DETAIL_DELAY_MS=1500


FLARESOLVERR_URL=
JOBSPY_URL=

DOCUMENTS_DIR=./data/documents

MINIO_ENDPOINT=
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=documents
MINIO_USE_SSL=false
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin

RESUME_GROUNDING_LEVEL=moderate
# RENDERCV_BIN — obsolete, ignored (rendercv-go runs in-process); kept for one release for compatibility

LEVELS_FYI_CSV=
# Minimum annual salary in USD; 0 = disabled
SALARY_FLOOR_USD=0

# Recruiter/hiring-manager resolution (007)
# LinkedIn's public company page is a ToS gray area — off by default. The
# posting-text and company-page contact sources always run regardless.
LINKEDIN_SCRAPE_ENABLED=false

# --- LLM observability collector (036-langfuse-llm-observability) ---
#
# Self-hosted Langfuse, wired to the gateway through litellm's success/failure
# callbacks rather than to the application — apps/api reads none of these.
# Every variable is empty by default and every empty value is safe; what it
# costs you differs per variable, so each says so.
#
# These three are read by the *litellm container*, not by the collector, and
# they are what switches recording on. Empty means the callback is inert: the
# proxy serves every request exactly as before and writes no record. A dead or
# hung collector is likewise not allowed to slow or fail a call (FR-004).
#
# LANGFUSE_HOST must be a container-network address — the collector is reached
# from inside the compose network. Same trap GATEWAY_URL documents above: use
# http://127.0.0.1:3100 only for host-side verification, never here.
# LANGFUSE_HOST=http://langfuse-web:3000
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=

# The collector's own storage. Empty means the collector fails to start;
# nothing else in the stack is affected.
#
# Its metadata lives in a SEPARATE LOGICAL DATABASE on the platform's Postgres
# server — never the platform's schema, and never managed by goose. Create it
# once by hand; the pgdata volume already exists, so an init script will not
# run. See specs/domains/platform-operations.md.
# LANGFUSE_DB_URL=postgresql://jobfinder:${DB_PASSWORD}@postgres:5432/langfuse
LANGFUSE_DB_URL=
# LANGFUSE_CLICKHOUSE_URL=http://clickhouse:8123
LANGFUSE_CLICKHOUSE_URL=
# LANGFUSE_CLICKHOUSE_MIGRATION_URL=clickhouse://clickhouse:9000
LANGFUSE_CLICKHOUSE_MIGRATION_URL=
LANGFUSE_CLICKHOUSE_USER=clickhouse
LANGFUSE_CLICKHOUSE_PASSWORD=
# LANGFUSE_REDIS_URL=redis://redis:6379/2
LANGFUSE_REDIS_URL=
# Event blobs go to the existing MinIO, in their own bucket.
# LANGFUSE_S3_ENDPOINT=http://minio:9000
LANGFUSE_S3_ENDPOINT=
LANGFUSE_S3_BUCKET=langfuse
LANGFUSE_S3_ACCESS_KEY=
LANGFUSE_S3_SECRET_KEY=
LANGFUSE_S3_REGION=auto

# Collector auth. Empty NEXTAUTH_SECRET, NEXTAUTH_URL or SALT means the
# collector refuses to start — these are not optional once you run it.
# NEXTAUTH_URL must match the address you open in the browser.
# Generate the secrets with `openssl rand -base64 32`.
# NEXTAUTH_URL=http://127.0.0.1:3100
NEXTAUTH_URL=
NEXTAUTH_SECRET=
SALT=
LANGFUSE_ENCRYPTION_KEY=
# Empty here would mean OPEN SIGNUP — anyone who can reach the UI can create an
# account, and the collector holds the user's legal name, employers and contact
# details in plain text. It defaults to true in compose for that reason; set it
# to false only for the one-time initial account creation, then set it back.
AUTH_DISABLE_SIGNUP=true

# How long collected records are kept, in days. Automated retention is not an
# OSS feature, so the platform prunes for itself on the cron scheduler. Empty
# means 30 days.
EVAL_PRUNE_RETENTION_DAYS=30
# What the pruning job needs to reach the collector. These ARE read by the
# application, unlike every LANGFUSE_* variable above — the app has to be able
# to delete for the retention window to mean anything. They are separately
# named so the grant is explicit and separately revocable: a collector API key
# is not a provider credential, and the application still holds none of those.
# Empty means no pruning runs; the collector then keeps records forever, so
# leaving these empty while collection is on is a deliberate choice.
# EVAL_PRUNE_COLLECTOR_URL=http://127.0.0.1:3100
EVAL_PRUNE_COLLECTOR_URL=
EVAL_PRUNE_PUBLIC_KEY=
EVAL_PRUNE_SECRET_KEY=
