# Postgres
DB_PASSWORD=change-me
DATABASE_URL=postgresql://jobfinder:change-me@localhost:5432/jobfinder
# Per-worktree isolation: Makefile derives COMPOSE_PROJECT_NAME and
# POSTGRES_HOST_PORT from the worktree path so each branch gets its own
# Postgres container and never shares migration state. Override here to pin.
# POSTGRES_HOST_PORT=5432
# COMPOSE_PROJECT_NAME=jobfinder

# Redis (BullMQ)
REDIS_URL=redis://localhost:6379

# Test database (separate DB name in same Postgres container, separate Redis DB index)
TEST_DATABASE_URL=postgresql://jobfinder:${DB_PASSWORD}@localhost:5432/jobfinder_test
TEST_REDIS_URL=redis://localhost:6379/1

# LLM — Ollama only. OLLAMA_KEY authenticates to Ollama Cloud (https://ollama.com)
# via a Bearer header; leave it empty for a local Ollama server.
OLLAMA_URL=https://ollama.com
OLLAMA_KEY=
# EMBED_URL: endpoint for embeddings. Blank = same as OLLAMA_URL (Ollama Cloud
# serves embeddings too, so this normally stays blank).
EMBED_URL=
# Per-task chat models. LLM_MODEL is the fallback for any task var left empty.
LLM_MODEL=gpt-oss:120b-cloud
LLM_MODEL_MATCH=gpt-oss:20b-cloud
LLM_MODEL_GENERATION=gpt-oss:120b-cloud
# Keyword-diff rephrase suggester model (008-5); empty falls back to LLM_MODEL.
LLM_MODEL_REPHRASE=gpt-oss:120b-cloud
# Ghost-job detector model (005); empty falls back to LLM_MODEL.
LLM_MODEL_GHOST=gpt-oss:120b-cloud
# Cerebras (001-cerebras-model-toggle): optional second chat provider,
# selectable per task from dashboard Settings. Leave CEREBRAS_API_KEY empty to
# keep Cerebras unavailable — every task then resolves to Ollama regardless of
# its persisted setting. No embeddings endpoint; embeddings stay on Ollama.
CEREBRAS_API_KEY=
CEREBRAS_BASE_URL=https://api.cerebras.ai/v1
# OpenRouter: optional third chat provider, selectable per task from dashboard
# Settings exactly like Cerebras. Leave OPENROUTER_API_KEY empty to keep
# OpenRouter unavailable — tasks set to it then resolve to Ollama. Get a key at
# openrouter.ai/keys. No embeddings endpoint; embeddings stay on Ollama.
# OPENROUTER_SITE_URL / OPENROUTER_APP_NAME are optional attribution headers
# (HTTP-Referer / X-Title) used for OpenRouter's public leaderboards.
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_SITE_URL=
OPENROUTER_APP_NAME=job-finder
EMBED_MODEL=nomic-embed-text
EMBED_DIMS=768
MATCH_SIMILARITY_THRESHOLD=0.35
# Lifetime (seconds) of cached keyword-diff rephrase suggestions (async/cached).
KEYWORD_REPHRASE_CACHE_TTL_SEC=900

# 32-byte hex key for aes-256-gcm encryption of JobSource.config
# generate: openssl rand -hex 32
CONFIG_ENCRYPTION_KEY=

# 32-byte hex key (HMAC-SHA256) signing the browser-extension access token.
# generate: openssl rand -hex 32
# If unset, a random ephemeral secret is generated at process start and
# extension access tokens stop validating across restarts.
EXT_JWT_SECRET=

# Job source credentials
ADZUNA_APP_ID=
ADZUNA_APP_KEY=
ADZUNA_COUNTRY=gb
# Djinni login — adapter logs in and stores the sessionid cookie in the DB.
DJINNI_EMAIL=
DJINNI_PASSWORD=
# Delay (ms) before each djinni job-detail fetch during enrichment backfill
DJINNI_DETAIL_DELAY_MS=1500

# Sidecar / optional services
FLARESOLVERR_URL=

# Paths
# Container/compose deployments override this to /data/documents (see
# docker-compose.yml, docker-compose.prod.yml, apps/api/Dockerfile); bare-metal
# dev defaults to a repo-relative dir since the host user can't mkdir /data.
DOCUMENTS_DIR=./data/documents

# MinIO object storage for generated resume/cover-letter files. Leave
# MINIO_ENDPOINT empty to disable (files stay on DOCUMENTS_DIR only). With the
# bundled docker-compose minio service, use MINIO_ENDPOINT=minio:9000.
MINIO_ENDPOINT=
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=documents
MINIO_USE_SSL=false
# Root credentials for the bundled minio container (compose reads these).
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin

# RenderCV tailoring (vacancy-tailored resume)
RESUME_MASTER_PATH=./resume/resume.yaml
RESUME_GROUNDING_LEVEL=moderate
RENDERCV_BIN=rendercv

# Salary inference
# Path to the levels.fyi CSV export; empty disables this source
LEVELS_FYI_CSV=
# Minimum annual salary in USD; 0 = disabled
SALARY_FLOOR_USD=0

# Recruiter/hiring-manager resolution (007)
# LinkedIn's public company page is a ToS gray area — off by default. The
# posting-text and company-page contact sources always run regardless.
LINKEDIN_SCRAPE_ENABLED=false
